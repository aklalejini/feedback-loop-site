# Required: LLM access for the reviewer + manager.
ANTHROPIC_API_KEY=

# Optional: Plausible Stats API access. When set, the manager folds in real
# behavior signals; otherwise it runs reviewer-only and notes that in output.
PLAUSIBLE_API_KEY=
